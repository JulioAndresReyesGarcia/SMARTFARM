# Copiar a .env y ajustar valores (NUNCA commitear .env real)

NODE_ENV=development
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartfarm
DB_USER=smartfarm
DB_PASSWORD=smartfarm_secret

# JWT — usar cadena larga y aleatoria en producción
JWT_SECRET=cambiar_por_secreto_largo_y_aleatorio_min_32_chars
JWT_EXPIRES_IN=24h

# CORS — URL del cliente Flutter (emulador Android: 10.0.2.2)
CORS_ORIGIN=*

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Usuario demo (solo seed inicial)
DEMO_ADMIN_EMAIL=admin@smartfarm.ai
DEMO_ADMIN_PASSWORD=1234

# IA conversacional (OpenAI recomendado — económico y estable)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Alternativa: Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Proveedor: auto | openai | gemini
AI_PROVIDER=auto
